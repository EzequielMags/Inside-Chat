# Copie para .env
PORT=3000
# Quantos proxies reversos confiáveis existem na frente do app (0 = nenhum; 1 = um proxy/CDN).
# Use o número real: valores a mais permitem forjar o IP e burlar os limites de tentativas.
TRUST_PROXY=0
NODE_ENV=development
DB_PATH=data/cordial.db
TIMEZONE=America/Sao_Paulo
TZ_OFFSET=-03:00

# Primeiro admin (criado só se não houver usuários). Se omitir a senha, uma é gerada e impressa no console.
SEED_ADMIN_EMAIL=admin@cordial.local
SEED_ADMIN_PASSWORD=

# Cadastro com aprovação: o link de aprovação chega neste e-mail (use o Gmail do administrador).
APPROVAL_EMAIL=
PUBLIC_URL=http://localhost:3000
# Envio do e-mail (Gmail: ative a verificação em 2 etapas e crie uma "senha de app"). Sem isso, o e-mail é impresso no console (só em desenvolvimento).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp: "mock" (padrão, sem Meta) ou "cloud"
WA_MODE=mock
WA_VERIFY_TOKEN=troque-por-um-token-longo
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0

# Produção (NODE_ENV=production exige PUBLIC_URL https, WA_MODE=cloud e WA_VERIFY_TOKEN forte; senão o app não sobe)
HOST=127.0.0.1
# Retenção LGPD: dias após a resolução para apagar conversas (0 = desligado; prazo a definir com o jurídico)
RETENTION_DAYS=0
BACKUP_DIR=backups
BACKUP_KEEP=14
