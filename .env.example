# Copie para .env
PORT=3000
NODE_ENV=development
DB_PATH=data/cordial.db
TIMEZONE=America/Sao_Paulo
TZ_OFFSET=-03:00

# Primeiro admin (criado só se não houver usuários). Se omitir a senha, uma é gerada e impressa no console.
SEED_ADMIN_EMAIL=admin@cordial.local
SEED_ADMIN_PASSWORD=

# WhatsApp: "mock" (padrão, sem Meta) ou "cloud"
WA_MODE=mock
WA_VERIFY_TOKEN=troque-por-um-token-longo
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
